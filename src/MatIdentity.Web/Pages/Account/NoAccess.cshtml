@page
@model MatIdentity.Web.Pages.Account.NoAccessModel
@{
    Layout = "_SignIn";
    ViewData["Title"] = "No access";
    // A brand that hides MatIdentity: no way to MatIdentity's own home page (its app is what the person may not open).
    var brand = await SignInBranding.ResolveAsync(HttpContext);
    var hidden = brand is { HideIdentity: true };
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        <partial name="_AuthLogo" />
        <h1>No access to @Model.AppName</h1>
        <p class="mat-muted">You are signed in as @User.GetDisplayName(), but @Model.AppName was not given to you. Ask an administrator to give it to you or to one of your groups.</p>
    </div>
    <div class="mat-btn-row mat-btn-row--plain">
        @if (!hidden)
        {
            <a href="/" class="mat-btn mat-btn--primary"><icon name="home" /><span>Your apps</span></a>
        }
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="mat-btn @(hidden ? "mat-btn--primary" : "mat-btn--secondary")"><icon name="logout" /><span>Sign in as someone else</span></button>
        </form>
    </div>
</div>
