@page
@{
    Layout = "_SignIn";
    ViewData["Title"] = "Access denied";
    // A brand that hides MatIdentity: back to its app, never to MatIdentity's own home page.
    var brand = await SignInBranding.ResolveAsync(HttpContext);
    var home = brand is { HideIdentity: true } ? brand.HomeUrl : "/";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        <partial name="_AuthLogo" />
        <h1>Access denied</h1>
        <p class="mat-muted">You do not have the permissions to open this page.</p>
    </div>
    @if (home is not null)
    {
        <a href="@home" class="mat-btn mat-btn--primary mat-btn--block"><icon name="home" /><span>@(brand is { HideIdentity: true } ? $"Back to {brand.Name}" : "Back to Home")</span></a>
    }
</div>
