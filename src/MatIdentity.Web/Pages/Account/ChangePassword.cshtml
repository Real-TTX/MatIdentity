@page
@model MatIdentity.Web.Pages.Account.ChangePasswordModel
@{
    Layout = "_SignIn";
    ViewData["Title"] = "New password";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        <partial name="_AuthLogo" />
        <h1>Set your own password</h1>
        <p class="mat-muted">Please choose a new password before you continue, for your account @User.GetDisplayName().</p>
    </div>

    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <partial name="_ValidationSummary" />
        <mat-field label="Current password" asp-for="Input.CurrentPassword" required="true">
            <input asp-for="Input.CurrentPassword" type="password" class="mat-input" autocomplete="current-password" autofocus required data-msg-required="Please enter your current password." />
        </mat-field>
        <mat-field label="New password" asp-for="Input.NewPassword" required="true" hint="At least @Model.MinPasswordLength characters, not your user name.">
            <input asp-for="Input.NewPassword" type="password" class="mat-input" autocomplete="new-password" required minlength="@Model.MinPasswordLength" data-msg-required="Please enter a new password." data-msg-range="Use at least @Model.MinPasswordLength characters." />
        </mat-field>
        <mat-field label="Confirm new password" asp-for="Input.ConfirmPassword" required="true">
            <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" required data-msg-required="Please repeat the new password." />
        </mat-field>
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block"><icon name="save" /><span>Save and continue</span></button>
        </div>
    </form>

    <form method="post" action="/Account/Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--block"><icon name="logout" /><span>Sign out</span></button>
    </form>
</div>
