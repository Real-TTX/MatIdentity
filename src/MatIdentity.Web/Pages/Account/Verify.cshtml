@page
@model MatIdentity.Web.Pages.Account.VerifyModel
@{
    Layout = "_SignIn";
    ViewData["Title"] = "E-mail address";
    // A brand that hides MatIdentity: back to its app, never to MatIdentity's own home page.
    var brand = await SignInBranding.ResolveAsync(HttpContext);
    var home = brand is { HideIdentity: true } ? brand.HomeUrl : "/";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        <partial name="_AuthLogo" />
        @if (Model.Email is not null)
        {
            <h1>Address confirmed</h1>
            <p class="mat-muted">@Model.Email is confirmed. Thank you.</p>
        }
        else
        {
            <h1>This link does not work</h1>
            <p class="mat-muted">It was used already, it is too old, or the address has changed since. Ask for a new one on your account page.</p>
        }
    </div>
@if (Model.Email is not null && User.Identity?.IsAuthenticated != true)
    {
        <a class="mat-btn mat-btn--primary mat-btn--block" href="/Account/Login"><icon name="login" /><span>Sign in</span></a>
    }
    else if (home is not null)
    {
            <a class="mat-btn mat-btn--primary mat-btn--block" href="@home"><icon name="home" /><span>@(brand is { HideIdentity: true } ? $"Back to {brand.Name}" : "Your apps")</span></a>
    }
</div>
