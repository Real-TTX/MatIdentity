@page
@model MatIdentity.Web.Pages.Account.ForgotModel
@{
    Layout = "_Bare";
    ViewData["Title"] = "Forgot your password?";
    var back = "/Account/Login" + (string.IsNullOrEmpty(Model.ReturnUrl) ? string.Empty : "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl));
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>Forgot your password?</h1>
        <p class="mat-muted">We send a link to the e-mail address of your account. It works for 30 minutes.</p>
    </div>

    @if (Model.Sent)
    {
        <div class="mat-alert mat-alert--success" role="status"><icon name="mail" /><div class="mat-alert__body">If there is an account with an e-mail address for this name, the link is on its way.</div></div>
    }
    else
    {
        <form method="post" class="mat-form" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_ValidationSummary" />
            <mat-field label="Username or e-mail" asp-for="Login">
                <input asp-for="Login" class="mat-input" autocomplete="username" autofocus required data-msg-required="Please enter your username or e-mail." />
            </mat-field>
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block"><icon name="mail" /><span>Send the link</span></button>
            </div>
        </form>
    }

    <a class="mat-btn mat-btn--ghost mat-btn--block" href="@back">Back to sign-in</a>
</div>
