@page
@model MatIdentity.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "People";
    ViewData["PageSub"] = "Who can sign in to all Mat apps, and who administers MatIdentity.";
    ViewData["Crumbs"] = Crumbs.Of(("People", null));
    var currentUserId = User.GetUserId();
    var list = Model.List;
}

<div class="mat-list">
    <partial name="_Toolbar" model="list.Toolbar" />

    @if (list.Items.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><icon name="users" /></span>
            <div class="mat-empty__title">Nothing matches</div>
            <p>No person matches. Change the search or the filter.</p>
            <a class="mat-btn mat-btn--secondary" href="/Users">Reset the tools</a>
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">People</caption>
                <thead>
                    <tr><th scope="col">Username</th><th scope="col" class="mat-hide-sm">Display name</th><th scope="col" class="mat-hide-sm">E-mail</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col" class="mat-hide-sm">Second step</th><th scope="col" class="mat-hide-sm">Last login</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in list.Items)
                    {
                        <tr>
                            <td data-label="Username"><div class="mat-table__name"><a href="/Users/Edit?id=@u.Id">@u.Username</a></div></td>
                            <td data-label="Display name" class="mat-hide-sm">@u.DisplayName</td>
                            <td data-label="E-mail" class="mat-hide-sm">@(u.Email ?? "–")</td>
                            <td data-label="Role">@u.Role</td>
                            <td data-label="Status">
                                @if (u.PendingRegistration)
                                {
                                    <span class="mat-pill">Unconfirmed</span>
                                }
                                else if (u.IsActive && u.LockedUntil > DateTime.UtcNow)
                                {
                                    <span class="mat-pill mat-pill--warn">Locked</span>
                                }
                                else if (u.IsActive && Model.Invited.Contains(u.Id))
                                {
                                    <span class="mat-pill mat-pill--info">Invited</span>
                                }
                                else if (u.IsActive)
                                {
                                    <span class="mat-pill mat-pill--ok">Active</span>
                                }
                                else
                                {
                                    <span class="mat-pill">Inactive</span>
                                }
                            </td>
                            <td data-label="Second step" class="mat-hide-sm">
                                @{ var keys = Model.PasskeyCounts.GetValueOrDefault(u.Id); }
                                @if (u.TotpEnabled) { <span class="mat-pill mat-pill--ok">App</span> }
                                @if (keys > 0) { <span class="mat-pill mat-pill--ok">@(keys == 1 ? "Passkey" : keys + " passkeys")</span> }
                                @if (!u.TotpEnabled && keys == 0) { <span class="mat-muted">–</span> }
                            </td>
                            <td data-label="Last login" class="mat-hide-sm mat-muted mat-nowrap mat-mono">@(u.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "–")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Users/Edit?id=@u.Id" aria-label="Edit @u.Username" data-tip="Edit"><icon name="edit" /></a>
                                    @if (u.Id != currentUserId)
                                    {
                                        <form method="post" asp-page-handler="Delete" data-confirm="Delete the user @u.Username? They can no longer sign in, and every app signs them out." data-confirm-ok="Delete" data-confirm-danger>
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" aria-label="Delete @u.Username" data-tip="Delete"><icon name="trash" /></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" model="list.Pager" />

    <div class="mat-actions">
        <a href="/Users/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New person</span></a>
    </div>
</div>
