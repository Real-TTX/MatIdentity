@page
@model MatIdentity.Web.Pages.Users.EditModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit person" : "New person";
    ViewData["PageSub"] = Model.IsEdit ? "Change the name, the e-mail, the role or the password." : "Creates an account that signs in to all apps.";
    ViewData["Crumbs"] = Crumbs.Of(("People", "/Users"), (Model.IsEdit ? Model.Input.Username : "New person", null));
    ViewData["Width"] = "narrow";
    var pwHint = Model.IsEdit ? "Leave blank to keep the current password. A new one signs the person out everywhere." : $"At least {Model.MinPasswordLength} characters, not the user name.";
}

@if (Model.LockedUntil is { } locked)
{
    <div class="mat-alert mat-alert--warning" role="status">
        <icon name="lock" />
        <div class="mat-alert__body">Locked until @Format.DateTimeLocal(locked): too many wrong passwords or codes in a row. A passkey still signs the person in.</div>
        <form method="post" asp-page-handler="Unlock">
            <input type="hidden" name="id" value="@Model.Input.Id" />
            <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm"><icon name="lock" /><span>Unlock</span></button>
        </form>
    </div>
}

<form method="post" class="mat-form" novalidate>
    <input type="hidden" asp-for="Input.Id" />
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <mat-field label="Username" asp-for="Input.Username" required="true">
                    <input asp-for="Input.Username" class="mat-input" autocomplete="off" readonly="@Model.IsEdit" required data-msg-required="Please enter a username." />
                </mat-field>

                <mat-field label="Display name" asp-for="Input.DisplayName" required="true">
                    <input asp-for="Input.DisplayName" class="mat-input" required data-msg-required="Please enter a display name." />
                </mat-field>

                <mat-field label="E-mail" asp-for="Input.Email" hint="Optional. An app links an existing account by it.">
                    <input asp-for="Input.Email" type="email" class="mat-input" autocomplete="off" data-msg-type="Please enter a valid e-mail address." />
                </mat-field>

                <mat-field label="Role" asp-for="Input.Role" hint="An administrator manages MatIdentity; the apps see the role as admin or user.">
                    <select asp-for="Input.Role" class="mat-select">
                        <option value="User">User</option>
                        <option value="Admin">Admin</option>
                    </select>
                </mat-field>

                <div class="mat-field">
                    <span class="mat-label">Status</span>
                    <label class="mat-check">
                        <input asp-for="Input.IsActive" type="checkbox" />
                        <span class="mat-check__text">Account is active</span>
                    </label>
                    <span class="mat-hint">A disabled account is signed out of every app.</span>
                    <span class="mat-error"></span>
                </div>

                @if (Model.AllGroups.Count > 0)
                {
                    <fieldset class="mat-field mat-fieldset mat-field--full">
                        <legend class="mat-label">Groups</legend>
                        @foreach (var g in Model.AllGroups)
                        {
                            <label class="mat-check">
                                <input type="checkbox" name="Input.GroupIds" value="@g.Id" checked="@Model.Input.GroupIds.Contains(g.Id)" />
                                <span class="mat-check__text">@g.Name</span>
                            </label>
                        }
                        <span class="mat-hint">A group gets apps and roles for all its people at once.</span>
                    </fieldset>
                }

                @if (!Model.IsEdit && Model.MailAvailable)
                {
                    <div class="mat-field mat-field--full">
                        <span class="mat-label">Password</span>
                        <label class="mat-check">
                            <input asp-for="Input.Invite" type="checkbox" />
                            <span class="mat-check__text">Send an invitation: the person chooses the password</span>
                        </label>
                        <span class="mat-hint">The link goes to the e-mail address and works for 7 days.</span>
                    </div>
                }

                <div class="mat-field--full mat-form__grid" data-show-if="@(!Model.IsEdit && Model.MailAvailable ? "#Input_Invite" : null)" data-show-value="false">
                <mat-field label="Password" asp-for="Input.Password" required="@(!Model.IsEdit)" hint="@pwHint">
                    <input asp-for="Input.Password" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>

                <mat-field label="Confirm password" asp-for="Input.ConfirmPassword" required="@(!Model.IsEdit)">
                    <input asp-for="Input.ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
                </div>
            </div>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
        <a href="/Users" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back</span></a>
    </div>
</form>

@if (Model.IsEdit)
{
    <div class="mat-card">
        <div class="mat-card__head"><icon name="monitor" /><span class="mat-card__title">Signed in</span></div>
        @if (Model.Sessions.Count == 0)
        {
            <div class="mat-card__body"><p class="mat-muted">Not signed in anywhere right now.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Where @Model.Input.DisplayName is signed in</caption>
                    <thead><tr><th scope="col">Device</th><th scope="col" class="mat-hide-sm">Address</th><th scope="col">Last seen</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td data-label="Device"><span class="mat-table__name">@Format.Browser(s.UserAgent)</span></td>
                                <td data-label="Address" class="mat-hide-sm mat-mono">@(s.IpAddress ?? "–")</td>
                                <td data-label="Last seen" class="mat-nowrap">@Format.Ago(s.LastSeenAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mat-card__body">
                <form method="post" asp-page-handler="SignOut" data-confirm="Sign @Model.Input.DisplayName out everywhere? Every device and every app asks for the sign-in again." data-confirm-ok="Sign out" data-confirm-danger>
                    <input type="hidden" name="id" value="@Model.Input.Id" />
                    <button type="submit" class="mat-btn mat-btn--danger"><icon name="logout" /><span>Sign out everywhere</span></button>
                </form>
            </div>
        }
    </div>
}

@if (Model.IsEdit && Model.MailAvailable && !string.IsNullOrEmpty(Model.Input.Email))
{
    <div class="mat-card">
        <div class="mat-card__head"><icon name="mail" /><span class="mat-card__title">Mail</span></div>
        <div class="mat-card__body mat-stack">
            <p>
                @Model.Input.Email
                <span class="mat-pill @(Model.EmailVerified ? "mat-pill--ok" : string.Empty)">@(Model.EmailVerified ? "Confirmed" : "Not confirmed")</span>
                @if (Model.InvitationOpen)
                {
                    <span class="mat-pill mat-pill--info">Invited</span>
                }
            </p>
            <div class="mat-btn-row mat-btn-row--plain">
                @if (Model.InvitationOpen)
                {
                    <form method="post" asp-page-handler="Invite">
                        <input type="hidden" name="id" value="@Model.Input.Id" />
                        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="mail" /><span>Send the invitation again</span></button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="SendReset">
                        <input type="hidden" name="id" value="@Model.Input.Id" />
                        <button type="submit" class="mat-btn mat-btn--secondary"><icon name="key" /><span>Send a link for a new password</span></button>
                    </form>
                }
            </div>
        </div>
    </div>
}

@if (Model.IsEdit && (Model.UsesAuthenticator || Model.PasskeyCount > 0))
{
    <div class="mat-card">
        <div class="mat-card__head"><icon name="shield" /><span class="mat-card__title">Second step</span></div>
        <div class="mat-card__body mat-stack">
            <p>@Model.Input.DisplayName uses @(Model.UsesAuthenticator ? "an authenticator app" : string.Empty)@(Model.UsesAuthenticator && Model.PasskeyCount > 0 ? " and " : string.Empty)@(Model.PasskeyCount > 0 ? (Model.PasskeyCount == 1 ? "a passkey" : Model.PasskeyCount + " passkeys") : string.Empty). Lost the phone or the device? Reset it, and they sign in with the password and set it up again.</p>
            <form method="post" asp-page-handler="ResetSecondStep" data-confirm="Reset the second step of @Model.Input.DisplayName? Their password alone then signs them in." data-confirm-ok="Reset" data-confirm-danger>
                <input type="hidden" name="id" value="@Model.Input.Id" />
                <button type="submit" class="mat-btn mat-btn--danger"><icon name="refresh" /><span>Reset the second step</span></button>
            </form>
        </div>
    </div>
}
