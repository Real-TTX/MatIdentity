@page
@model MatIdentity.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["PageSub"] = "The name, the public address, the sign-in and the mail.";
    ViewData["Crumbs"] = Crumbs.Of(("Settings", null));
    ViewData["Width"] = "narrow";
}

<form method="post" class="mat-form" novalidate>
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__head"><icon name="settings" /><span class="mat-card__title">General</span></div>
        <div class="mat-card__body mat-stack">
            <mat-field label="Name" asp-for="Input.InstanceName" required="true" hint="Shown on the sign-in page and in the menu.">
                <input asp-for="Input.InstanceName" class="mat-input" required maxlength="80" data-msg-required="Please enter a name." />
            </mat-field>
            <mat-field label="Public address" asp-for="Input.Issuer" hint="The address the apps reach MatIdentity at, like https://id.example.com. Empty: the address of each request. Takes effect after a restart.">
                <input asp-for="Input.Issuer" type="url" class="mat-input" placeholder="https://id.example.com" data-msg-type="Enter an absolute address like https://id.example.com." />
            </mat-field>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="key" /><span class="mat-card__title">Sign-in</span></div>
        <div class="mat-card__body mat-form__grid">
            <mat-field label="Stay signed in (days)" asp-for="Input.SessionLifetimeDays" required="true" hint="Without activity a person signs in again after this many days.">
                <input asp-for="Input.SessionLifetimeDays" type="number" class="mat-input" min="1" max="365" required data-msg-range="Choose between 1 and 365 days." />
            </mat-field>
            <mat-field label="Access token (minutes)" asp-for="Input.AccessTokenMinutes" required="true" hint="Short is safer; the apps renew it on their own. Takes effect after a restart.">
                <input asp-for="Input.AccessTokenMinutes" type="number" class="mat-input" min="5" max="1440" required data-msg-range="Choose between 5 and 1440 minutes." />
            </mat-field>
            <mat-field label="Shortest password" asp-for="Input.PasswordMinLength" required="true" hint="For new passwords. Never the user name, never one of the passwords tried first.">
                <input asp-for="Input.PasswordMinLength" type="number" class="mat-input" min="8" max="128" required data-msg-range="Choose between 8 and 128 characters." />
            </mat-field>
            <div class="mat-field mat-field--full">
                <span class="mat-label">Registration</span>
                <label class="mat-check">
                    <input asp-for="Input.AllowRegistration" type="checkbox" />
                    <span class="mat-check__text">People may create their own account</span>
                </label>
                <span class="mat-hint">On the sign-in page, with mail and the public address. The account works after the e-mail address is confirmed and gets only the apps open to everyone.</span>
            </div>
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><icon name="mail" /><span class="mat-card__title">Mail</span></div>
        @if (Model.Relay.Target is { } relay)
        {
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">@Model.Relay.Description</p>
                <dl class="mat-kv">
                    <dt>Server</dt><dd class="mat-mono">@relay.Host:@relay.Port</dd>
                    <dt>Security</dt><dd>@MatIdentity.Core.Mail.SmtpTarget.Name(relay.Tls)</dd>
                    <dt>User</dt><dd class="mat-mono">@(relay.Username ?? "–")</dd>
                    <dt>Sender</dt><dd class="mat-mono">@relay.From</dd>
                </dl>
            </div>
        }
        else
        {
            <div class="mat-card__body mat-form__grid">
                <p class="mat-muted mat-field--full">For password resets, invitations and confirming e-mail addresses. Without a server these are hidden.</p>
                <mat-field label="SMTP server" asp-for="Input.SmtpHost" hint="Empty: no mail.">
                    <input asp-for="Input.SmtpHost" class="mat-input" placeholder="smtp.example.com" autocomplete="off" />
                </mat-field>
                <mat-field label="Port" asp-for="Input.SmtpPort">
                    <input asp-for="Input.SmtpPort" type="number" class="mat-input" min="1" max="65535" data-msg-range="Choose a port between 1 and 65535." />
                </mat-field>
                <mat-field label="Security" asp-for="Input.SmtpTls">
                    <select asp-for="Input.SmtpTls" class="mat-select">
                        <option value="starttls">STARTTLS (587)</option>
                        <option value="tls">TLS (465)</option>
                        <option value="none">None</option>
                    </select>
                </mat-field>
                <mat-field label="Sender" asp-for="Input.SmtpFrom">
                    <input asp-for="Input.SmtpFrom" type="email" class="mat-input" placeholder="id@example.com" data-msg-type="Enter an address like id@example.com." />
                </mat-field>
                <mat-field label="User" asp-for="Input.SmtpUsername" hint="Empty: no sign-in at the server.">
                    <input asp-for="Input.SmtpUsername" class="mat-input" autocomplete="off" />
                </mat-field>
                <mat-field label="Password" asp-for="Input.SmtpPassword" hint="@(Model.HasSmtpPassword ? "Stored. Empty keeps it." : null)">
                    <input asp-for="Input.SmtpPassword" type="password" class="mat-input" autocomplete="new-password" />
                </mat-field>
            </div>
        }
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
        <a href="/" class="mat-btn mat-btn--secondary"><icon name="back" /><span>Back</span></a>
        @if (Model.MailAvailable)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--secondary mat-btn--end" asp-page-handler="TestMail" formnovalidate><icon name="mail" /><span>Send a test mail</span></button>
        }
    </div>
</form>

<div class="mat-card">
    <div class="mat-card__head"><icon name="link" /><span class="mat-card__title">Connecting apps</span></div>
    <div class="mat-card__body">
        <dl class="mat-kv">
            <dt>Authority</dt><dd class="mat-mono">@Model.AuthorityUrl</dd>
            <dt>Discovery</dt><dd class="mat-mono">@Model.AuthorityUrl/.well-known/openid-configuration</dd>
            <dt>Platform API</dt><dd>@(Model.ApiKeyEnabled ? "On: with the key MAT_API_KEY or a token for app:matidentity" : "Only with a token for app:matidentity (MAT_API_KEY is not set)")</dd>
        </dl>
    </div>
</div>

<div class="mat-card">
    <div class="mat-card__head"><icon name="download" /><span class="mat-card__title">Configuration</span></div>
    <div class="mat-card__body mat-stack">
        <p class="mat-muted">Settings, apps with their access and roles, groups and people as JSON, without any secret. A backup is the data volume: it also holds the keys that sign the tokens.</p>
        <div class="mat-btn-row mat-btn-row--plain">
            <a class="mat-btn mat-btn--secondary" href="/Settings?handler=Export"><icon name="download" /><span>Download the configuration</span></a>
        </div>
    </div>
</div>

<div class="mat-card">
    <div class="mat-card__head"><icon name="alert" /><span class="mat-card__title">Emergency</span></div>
    <div class="mat-card__body mat-stack">
        <p class="mat-muted">Ends every sign-in: here and, at their next renewal, in every app. Everyone signs in again, you too.</p>
        <form method="post" asp-page-handler="SignOutEveryone" data-confirm="Sign everyone out? Every person has to sign in again, in every app." data-confirm-ok="Sign everyone out" data-confirm-danger>
            <button type="submit" class="mat-btn mat-btn--danger"><icon name="logout" /><span>Sign everyone out</span></button>
        </form>
    </div>
</div>
